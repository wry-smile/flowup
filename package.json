{
  "name": "@wry-smile/flowup-started",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "description": "",
  "author": "",
  "license": "MIT",
  "keywords": [],
  "main": "./dist/index.js",
  "bin": {
    "flowup": "./bin/flowup.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "pnpm -F @wry-smile/flowup build",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:unit && pnpm test:integration && pnpm check:examples && pnpm test:e2e",
    "check:examples": "node scripts/check-examples.mjs",
    "gen:node": "cd packages/nodes && flowup gen",
    "gen:plugin": "cd packages/plugins && flowup gen",
    "lint": "pnpm -F @wry-smile/flowup lint",
    "release": "pnpm -F @wry-smile/flowup release",
    "test": "pnpm -F @wry-smile/flowup test",
    "test:e2e": "pnpm -F @wry-smile/flowup test:e2e",
    "test:integration": "pnpm -F @wry-smile/flowup test:integration",
    "test:unit": "pnpm -F @wry-smile/flowup test:unit",
    "typecheck": "pnpm -F @wry-smile/flowup typecheck"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "@types/node-red": "catalog:",
    "@wry-smile/flowup": "workspace:*",
    "@wry-smile/utils": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "node-red": "catalog:",
    "typescript": "catalog:"
  }
}
