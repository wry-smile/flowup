<% if (it.ctx.unocss) { -%>
import 'virtual:uno.css'
<% } else { -%>
import './config-panel.css'
<% } -%>
import type { EditorRED } from 'node-red'
import { mountConfigPanel } from './components/mount-config-panel'
import { createVanillaHydrateStore } from './hydrate'
import { PLUGIN_DISPLAY_NAME, PLUGIN_NAME, PLUGIN_SCOPE } from '../constant'

declare const RED: EditorRED

const store = createVanillaHydrateStore()
let dispose: (() => void) | undefined

RED.plugins.registerPlugin(PLUGIN_NAME, {
  onadd() {
    if (RED.sidebar.containsTab(PLUGIN_NAME)) return

    const target = document.createElement('div')
    target.dataset.flowupScope = PLUGIN_SCOPE
    target.className = 'flowup-vanilla-root'
    RED.sidebar.addTab({
      id: PLUGIN_NAME,
      name: PLUGIN_DISPLAY_NAME,
      label: PLUGIN_DISPLAY_NAME,
      iconClass: 'fa fa-puzzle-piece',
      content: target,
    })
    dispose?.()
    dispose = mountConfigPanel(target, store.getSnapshot(), (key, value) => {
      store.patch(key, value as never)
    })
  },
})
