{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
<% if (it.jsx) { -%>
    "jsx": "preserve",
<% } -%>
<% if (it.jsxImportSource) { -%>
    "jsxImportSource": "<%= it.jsxImportSource %>",
<% } -%>
    "paths": { "@/*": ["./*"], "@ui": ["./client/components/index.ts"], "@ui/*": ["./client/components/*"] },
    "types": ["vite/client", "jquery"],
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "client/**/*.ts",
    "client/**/*.tsx",
    "client/**/*.vue",
    "client/**/*.svelte",
    "client/**/*.d.ts",
    "constant/**/*.ts",
    "types/**/*.ts",
    "types/**/*.d.ts"
  ]
}
