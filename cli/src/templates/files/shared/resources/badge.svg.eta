<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 64" role="img" aria-label="<%= it.label %> badge">
  <rect width="160" height="64" rx="14" fill="#e0f2fe" />
  <circle cx="32" cy="32" r="20" fill="#0284c7" />
  <text x="32" y="39" fill="#fff" font-family="system-ui,sans-serif" font-size="21" font-weight="700" text-anchor="middle"><%= it.initial %></text>
  <text x="62" y="37" fill="#0c4a6e" font-family="system-ui,sans-serif" font-size="16" font-weight="700"><%= it.label %></text>
</svg>
