{
  "name": "@wry-smile/flowup",
  "type": "module",
  "version": "2.0.0",
  "description": "CLI for scaffolding, building, and assembling Node-RED nodes and plugins with Vite",
  "author": "@wry-smile",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "homepage": "https://github.com/wry-smile/flowup#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wry-smile/flowup.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/wry-smile/flowup/issues"
  },
  "keywords": [
    "node-red",
    "typescript",
    "scaffold",
    "cli",
    "vite"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "main": "./dist/index.js",
  "bin": {
    "flowup": "./dist/bin/flowup.js"
  },
  "files": [
    "README.md",
    "dist",
    "skills"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "release": "pnpm build && bumpp",
    "lint": "oxlint --config ../oxlint.config.ts --deny-warnings . && oxfmt --check .",
    "test": "pnpm build && pnpm test:unit && pnpm test:integration",
    "test:e2e": "node --test test/e2e/*.test.mjs",
    "test:integration": "node --test test/node-red-integration.test.mjs",
    "test:unit": "node --test test/assemble-boundaries.test.mjs test/build-assemble-failure-safety.test.mjs test/build-assemble-safety.test.mjs test/gen-safety.test.mjs test/framework-generation.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@unocss/core": "catalog:",
    "@unocss/preset-wind4": "catalog:",
    "chokidar": "catalog:",
    "commander": "catalog:",
    "find-up": "catalog:",
    "js-yaml": "catalog:",
    "picocolors": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "bumpp": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
