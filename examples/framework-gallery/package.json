{
  "name": "flowup-framework-gallery",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/framework-gallery-nodes.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "flowup build",
    "dev": "flowup dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p nodes/preact-node/tsconfig.json && tsc --noEmit -p nodes/solid-node/tsconfig.json && tsc --noEmit -p plugins/gallery-plugin/tsconfig.json"
  },
  "node-red": {
    "scope": "framework-gallery",
    "nodes": {
      "framework-gallery-nodes": "dist/framework-gallery-nodes.js"
    },
    "plugins": {
      "framework-gallery-plugins": "dist/framework-gallery-plugins.js"
    }
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.0.1",
    "@types/node-red": "^1.3.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@wry-smile/flowup": "workspace:*",
    "node-red": "^4.1.0",
    "preact": "^10.29.8",
    "solid-js": "^1.9.15",
    "svelte": "^5.56.4",
    "typescript": "^6.0.3",
    "unocss": "^66.10.5",
    "vite": "^8.1.0",
    "vite-plugin-solid": "^2.11.14",
    "vue": "^3.5.39"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "nanoid": "^6.0.1"
  }
}
