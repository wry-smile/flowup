{
  "name": "flowup-framework-gallery",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/framework-gallery-nodes.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "flowup build",
    "dev": "flowup dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p nodes/preact-node/tsconfig.json && tsc --noEmit -p nodes/solid-node/tsconfig.json && tsc --noEmit -p plugins/gallery-plugin/tsconfig.json"
  },
  "node-red": {
    "scope": "framework-gallery",
    "nodes": {
      "framework-gallery-nodes": "dist/framework-gallery-nodes.js"
    },
    "plugins": {
      "framework-gallery-plugins": "dist/framework-gallery-plugins.js"
    }
  },
  "flowup": {
    "entries": {
      "nodes/vue-node": {
        "framework": "vue",
        "unocss": true
      },
      "nodes/preact-node": {
        "framework": "preact",
        "unocss": true
      },
      "nodes/solid-node": {
        "framework": "solid",
        "unocss": true
      },
      "nodes/svelte-node": {
        "framework": "svelte",
        "unocss": true
      },
      "nodes/vanilla-node": {
        "framework": "vanilla",
        "unocss": false
      },
      "plugins/gallery-plugin": {
        "framework": "preact",
        "unocss": true
      }
    }
  },
  "devDependencies": {
    "@preact/signals": "^2.3.1",
    "@types/jquery": "catalog:",
    "@types/node": "catalog:",
    "@types/node-red": "catalog:",
    "@wry-smile/flowup": "catalog:",
    "node-red": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "vue": "catalog:",
    "unocss": "catalog:",
    "@preact/preset-vite": "^2.10.6",
    "preact": "^10.29.8",
    "solid-js": "^1.9.15",
    "vite-plugin-solid": "^2.11.14",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "svelte": "^5.56.4"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "nanoid": "^6.0.1"
  }
}
