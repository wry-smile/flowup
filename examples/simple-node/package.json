{
  "name": "flowup-simple-node",
  "type": "module",
  "version": "1.0.0",
  "description": "A Node-RED node built with Flowup.",
  "license": "MIT",
  "keywords": ["node-red", "flowup", "node-red-node"],
  "main": "./dist/simple-node.js",
  "files": ["dist", "resources"],
  "scripts": { "build": "flowup build", "dev": "flowup dev" },
  "devDependencies": {
    "@types/jquery": "catalog:",
    "@types/node-red": "catalog:",
    "@wry-smile/flowup": "catalog:",
    "node-red": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "vue": "catalog:",
    "unocss": "catalog:"
  },
  "node-red": {
    "scope": "simple-node",
    "nodes": { "simple-node": "dist/simple-node.js" }
  }
}
