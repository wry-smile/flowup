{
  "name": "flowup-simple-plugin",
  "type": "module",
  "version": "1.0.0",
  "description": "A Node-RED editor plugin built with Flowup.",
  "license": "MIT",
  "keywords": [
    "node-red",
    "flowup",
    "node-red-plugin"
  ],
  "main": "./dist/simple-plugin.js",
  "files": [
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "flowup build",
    "dev": "flowup dev"
  },
  "devDependencies": {
    "@types/jquery": "catalog:",
    "@types/node-red": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@wry-smile/flowup": "catalog:",
    "node-red": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:"
  },
  "node-red": {
    "scope": "simple-plugin",
    "plugins": {
      "simple-plugin": "dist/simple-plugin.js"
    }
  }
}
